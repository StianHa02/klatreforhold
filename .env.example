# Kopier til .env i repo-roten (ligger i .gitignore). Leses av Python-koden i modeling/ og av docker-compose.
# Utvikling bruker samme Supabase-database som produksjon, så treningsdata ligger ett sted.
SUPABASE_URL=https://nmiydpcmfxkhtztzgzfx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=        # Supabase → Project Settings → API Keys → secret
KLATREFORHOLD_CONTACT=            # e-post eller nettside, sendes i User-Agent til MET
KLATREFORHOLD_KILDE=dev           # observasjoner fra din maskin merkes "dev" og holdes utenfor trening
