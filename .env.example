# Kopier til .env i repo-roten. Python og Docker leser denne fila.
# Med disse nøklene bruker utvikling samme Supabase-database som produksjon.
SUPABASE_URL=https://nmiydpcmfxkhtztzgzfx.supabase.co
# Supabase → Project Settings → API Keys → service role (kun server)
SUPABASE_SERVICE_ROLE_KEY=
# E-post eller nettside som kontaktinfo i MET User-Agent
KLATREFORHOLD_CONTACT=
# Lokale observasjoner holdes utenfor trening som standard
KLATREFORHOLD_KILDE=dev
# Valgfri Frost-kontroll; API-et erstatter bare vær ved frost_bruk: erstatt
FROST_CLIENT_ID=
# Docker bruker api som standard; supabase leser publisert varsel
# KLATREFORHOLD_DATAKILDE=api
